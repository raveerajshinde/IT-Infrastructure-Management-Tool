#!/bin/bash
echo "curl $*" >>"$STUB_STATE/calls.log"
args="$*"
if [[ "$args" == *"-o /etc/apt"* ]]; then out=$(echo "$args" | sed 's/.*-o \([^ ]*\).*/\1/'); echo key >"$out"; exit 0; fi
if [[ "$args" == *readyz* ]]; then echo '{"status":"ok","checks":{"database":"ok","worker":"ok","vault":"ok"}}'; exit 0; fi
if [[ "$args" == *http_code* ]]; then echo 200; exit 0; fi
exit 0
