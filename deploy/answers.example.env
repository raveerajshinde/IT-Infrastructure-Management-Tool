# Answers for unattended installation:  sudo ./install.sh --non-interactive --answers answers.env --yes
IP_HOSTNAME=infrapilot.corp.local
IP_HTTPS_PORT=443
IP_TLS_CERT=                      # blank = self-signed
IP_TLS_KEY=
IP_MSSQL_EDITION=Express          # Express | Developer | Standard | Enterprise
IP_MSSQL_PRODUCT_KEY=             # required for Standard/Enterprise
IP_ADMIN_USER=admin
IP_ADMIN_EMAIL=it-admins@corp.local
IP_ADMIN_PASSWORD=                # blank = generated and printed once
IP_LDAP_CONFIGURE=N
IP_LDAP_URL=ldaps://dc01.corp.local:636
IP_LDAP_BASE_DN=DC=corp,DC=local
IP_LDAP_BIND_DN=CN=svc-infrapilot,OU=Service Accounts,DC=corp,DC=local
IP_LDAP_BIND_PASSWORD=
IP_LDAP_ADMIN_GROUP=CN=InfraPilot-Admins,OU=Groups,DC=corp,DC=local
IP_LDAP_CA=/root/corp-root-ca.pem
IP_CONFIGURE_FIREWALL=Y
