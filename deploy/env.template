# InfraPilot configuration (/opt/infrapilot/.env). Generated by install.sh; read by every container.
# Secrets are NOT stored here - they live in /opt/infrapilot/secrets/ (root:10001, mode 640) and are
# mounted as Docker secrets (/run/secrets/*).
# IP_APP_MODE: production | demo (demo allows clearly-marked simulated devices)
IP_APP_MODE=production
IP_VERSION=1.1.1
IP_PUBLIC_URL=https://infrapilot.example.local
IP_DB_NAME=infrapilot
IP_LOG_LEVEL=INFO

# Images (pinned; the offline bundle provides the same tags)
IP_IMAGE_API=infrapilot/api:1.1.1
IP_IMAGE_PROXY=infrapilot/proxy:1.1.1
IP_IMAGE_MSSQL=mcr.microsoft.com/mssql/server:2022-CU16-ubuntu-22.04
IP_MSSQL_MEMORY_MB=2048

# Network
IP_HTTPS_PORT=443
IP_HTTP_PORT=80
IP_HTTPS_BIND=0.0.0.0
IP_HTTP_BIND=0.0.0.0

# Sessions & account protection
IP_SESSION_TTL_MINUTES=480
IP_SESSION_IDLE_MINUTES=60
IP_COOKIE_SECURE=true
IP_LOCKOUT_THRESHOLD=5
IP_LOCKOUT_MINUTES=15
IP_PASSWORD_MIN_LENGTH=12
IP_RATE_LIMIT_LOGIN_PER_MINUTE=10
IP_RATE_LIMIT_API_PER_MINUTE=600

# Worker / automation
IP_WORKER_CONCURRENCY=4
IP_MONITORING_INTERVAL_SECONDS=120
IP_DEFAULT_JOB_TIMEOUT_SECONDS=900
IP_OPERATION_TIMEOUT_SECONDS=60
IP_API_WORKERS=2

# Active Directory bootstrap - applied once at install; afterwards manage in Settings -> Active Directory
IP_LDAP_ENABLED=false
IP_LDAP_URL=
IP_LDAP_BASE_DN=
IP_LDAP_BIND_DN=
IP_LDAP_BIND_PASSWORD_FILE=
IP_LDAP_CA_FILE=/opt/infrapilot/certs/ldap-ca.pem
IP_LDAP_GROUP_ROLE_MAP=

# SMTP bootstrap - applied once; afterwards manage in Settings -> E-mail (password is set in the UI)
IP_SMTP_HOST=
IP_SMTP_PORT=587
IP_SMTP_USER=
IP_SMTP_FROM=infrapilot@example.local
